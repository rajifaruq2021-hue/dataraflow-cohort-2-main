    "# What are Python exceptions? Write a program that handles division by zero.\n",
    "\n",
    "\n",
    "# An exception is an error that happens while our program is running. Normally, this would crash our program! But Python gives us a magical tool called a try...except block to gracefully \"catch\" these errors and handle them without crashing.\n",
    "\n",
    "\n",
    "\n",
    "# Example\n",
    "\n",
    "# A program to safely divide two numbers.\n",
    "\n",
    "try:\n",
    "    # We will \"try\" to run this code, which might cause an error.\n",
    "    numerator = 10\n",
    "    denominator = 0\n",
    "    \n",
    "    result = numerator / denominator\n",
    "    print(f\"The result is {result}\")\n",
    "\n",
    "# If a 'ZeroDivisionError' happens inside the 'try' block...\n",
    "except ZeroDivisionError:\n",
    "    # ...this code will run instead of crashing the program!\n",
    "    print(\"Oops! We can't divide by zero. That's a math rule!\")\n",
    "\n",
    "print(\"The program continued to run gracefully. Hooray!\")"
   ]
