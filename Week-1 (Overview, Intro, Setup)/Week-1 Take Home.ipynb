    "\n",
    "\n",
    "# Example\n",
    "\n",
    "for number in range(1, 51):\n",
    "    # The MOST important check must come first!\n",
    "    # A number is a multiple of both 3 and 5 if it's a multiple of 15.\n",
    "    # The % (modulo) operator gives us the remainder of a division.\n",
    "    if number % 15 == 0:\n",
    "        print(\"FizzBuzz\")\n",
    "    # If it's not a multiple of 15, maybe it's a multiple of 3?\n",
    "    elif number % 3 == 0:\n",
    "        print(\"Fizz\")\n",
    "    # If not a multiple of 3, maybe it's a multiple of 5?\n",
    "    elif number % 5 == 0:\n",
    "        print(\"Buzz\")\n",
    "    # If none of the above, just print the number itself.\n",
    "    else:\n",
    "        print(number)"
