    "# What are Python dictionaries? Write a short program to demonstrate\n",
    "\n",
    "# A  dictionary is like a real-world dictionary or a contact list on our phone. Instead of looking up items by their position (like in a list), we look them up by a unique key. Each key is paired with a value.\n",
    "\n",
    "\n",
    "# Example\n",
    "\n",
    "# Let's create a dictionary to store information about a user.\n",
    "# The keys are \"name\", \"age\", and \"city\".\n",
    "# The values are \"Alice\", 30, and \"New York\".\n",
    "user_profile = {\n",
    "    \"name\": \"Alice\",\n",
    "    \"age\": 30,\n",
    "    \"city\": \"New York\"\n",
    "}\n",
    "\n",
    "# To get a value, we use its key inside square brackets.\n",
    "user_name = user_profile[\"name\"]\n",
    "print(f\"The user's name is: {user_name}\")\n",
    "\n",
    "# We can also easily add new key-value pairs.\n",
    "user_profile[\"email\"] = \"alice@example.com\"\n",
    "print(f\"The full profile is now: {user_profile}\")"
   ]
