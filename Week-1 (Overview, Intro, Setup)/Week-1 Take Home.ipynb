   "source": [
    "# The difference between == and is operators in Python.\n",
    "\n",
    "# The == operator checks for equality. It asks the question, \"Do these two things have the same value?\"\n",
    "# The is operator checks for identity. It asks the question, \"Are these two things the exact same object in the computer's memory?\"\n",
    "\n",
    "# Examples\n",
    "\n",
    "# Here, == is True and is is also True\n",
    "a = [1, 2, 3]\n",
    "b = a  # b is not a copy, it's just another name for the exact same list!\n",
    "print(f\"a == b: {a == b}\") # True, because their values are the same\n",
    "print(f\"a is b: {a is b}\") # True, because they are the same object\n",
    "\n",
    "print(\"-\" * 20)\n",
    "\n",
    "# Here, == is True but is is False\n",
    "c = [1, 2, 3]\n",
    "d = [1, 2, 3] # d is a separate list, even though it looks the same\n",
    "print(f\"c == d: {c == d}\") # True, because their values are the same\n",
    "print(f\"c is d: {c is d}\") # False, because they are two different objects in memory"
   ]
  },
