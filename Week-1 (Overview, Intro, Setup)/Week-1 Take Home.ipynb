    "# What is the difference between local and global variables? Provide an example.\n",
    "\n",
    "# A global variable is like the sun. It lives outside of any function and can be seen (read) from anywhere in our code, both inside and outside functions.\n",
    "# A local variable is like a lamp inside a specific room. It is created inside a function and can only be used within that function. Once the function finishes, the local variable disappears.\n",
    "\n",
    "\n",
    "# Example\n",
    "\n",
    "# This is a global variable, seen by everyone!\n",
    "global_message = \"I'm the sun!\"\n",
    "\n",
    "def my_function():\n",
    "    # This is a local variable, it only exists inside this function.\n",
    "    local_message = \"I'm a lamp in a room.\"\n",
    "    print(local_message) # This works!\n",
    "    \n",
    "    # We can SEE the global variable from inside here.\n",
    "    print(f\"Inside the function, I can see: {global_message}\")\n",
    "\n",
    "# Let's run the function\n",
    "my_function()\n",
    "\n",
    "# We can see the global variable out here too.\n",
    "print(f\"Outside the function, I can see: {global_message}\")\n",
    "\n",
    "# This would cause an error because local_message doesn't exist out here!\n",
    "# print(local_message)"
   ]
