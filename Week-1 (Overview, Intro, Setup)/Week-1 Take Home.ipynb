   "source": [
    "# The use of the if __name__ == \"__main__\": statement.\n",
    "\n",
    "# it creates a special section of code that only runs when we execute the script directly. For imstance if we import the script as a module into another file, the code inside this if block will not run.\n",
    "# It's like having a \"For Your Eyes Only\" section in a secret agent's file that can only be read by the main agent, not by other agents who just borrow the file for information.\n",
    "\n",
    "# For Example\n",
    "\n",
    "# my_script.py\n",
    "\n",
    "def say_hello():\n",
    "    print(\"Hello from the function!\")\n",
    "\n",
    "print(\"This will always run when the file is touched!\")\n",
    "\n",
    "# This part ONLY runs if you execute `python my_script.py` in the terminal\n",
    "if __name__ == \"__main__\":\n",
    "    print(\"This script is being run directly!\")\n",
    "    say_hello()\n"
   ]
