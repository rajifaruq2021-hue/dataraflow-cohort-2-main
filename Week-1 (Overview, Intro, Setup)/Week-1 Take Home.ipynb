    "# A program to find the second largest number in a list.\n",
    "\n",
    "\n",
    "\n",
    "# Example\n",
    "\n",
    "def find_second_largest(numbers):\n",
    "    \"\"\"\n",
    "    Finds the second largest number in a list of numbers.\n",
    "    \"\"\"\n",
    "    # First, we convert the list to a 'set'. A set automatically\n",
    "    # removes any duplicate numbers! So [1, 5, 2, 5] becomes {1, 2, 5}.\n",
    "    unique_numbers = set(numbers)\n",
    "    \n",
    "    # We can't find a second largest if there are fewer than 2 unique numbers.\n",
    "    if len(unique_numbers) < 2:\n",
    "        return \"Not enough unique numbers to find a second largest.\"\n",
    "    \n",
    "    # Now we sort the unique numbers. This will give us a list\n",
    "    # like [1, 2, 5].\n",
    "    sorted_numbers = sorted(unique_numbers)\n",
    "    \n",
    "    # The second largest number will be the second item from the end\n",
    "    # of the sorted list. We use index -2 to get it!\n",
    "    return sorted_numbers[-2]\n",
    "\n",
    "# Let's test it!\n",
    "my_list = [10, 20, 4, 45, 99, 45, 99]\n",
    "second_largest = find_second_largest(my_list)\n",
    "print(f\"The second largest number is: {second_largest}\") # Output will be 45"
   ]
  },
