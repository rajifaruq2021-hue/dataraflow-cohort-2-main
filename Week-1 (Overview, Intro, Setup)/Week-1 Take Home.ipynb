   "source": [
    "# Write a program to check if a string is a palindrome.\n",
    "\n",
    "# A palindrome is a word or phrase that reads the same forwards and backward, like \"madam\" or \"racecar\"! To check for this, we need to clean up the string and then compare it to its reverse.\n",
    "\n",
    "\n",
    "\n",
    "# Example\n",
    "\n",
    "def is_palindrome(text):\n",
    "    \"\"\"\n",
    "    Checks if a string is a palindrome, ignoring case and spaces.\n",
    "    \"\"\"\n",
    "    # 1. Clean the string: make it lowercase and remove spaces.\n",
    "    #    We can loop through and build a new string.\n",
    "    cleaned_text = \"\"\n",
    "    for char in text.lower():\n",
    "        if char.isalnum(): # isalnum checks if it's a letter or number\n",
    "            cleaned_text += char\n",
    "            \n",
    "    # 2. Reverse the cleaned string. Python's slice notation [::-1]\n",
    "    #    is a magical way to reverse any sequence!\n",
    "    reversed_text = cleaned_text[::-1]\n",
    "    \n",
    "    # 3. Compare them! If they are the same, it's a palindrome.\n",
    "    return cleaned_text == reversed_text\n",
    "\n",
    "# Let's test it with a few examples!\n",
    "print(f\"'racecar' is a palindrome: {is_palindrome('racecar')}\")\n",
    "print(f\"'hello' is a palindrome: {is_palindrome('hello')}\")\n",
    "print(f\"'A man a plan a canal Panama' is a palindrome: {is_palindrome('A man a plan a canal Panama')}\")"
   ]
  },
