    "# Let's set up our two variables\n",
    "a = 10\n",
    "b = 20\n",
    "\n",
    "print(f\"Before swap: a = {a}, b = {b}\")\n",
    "\n",
    "# Here is out it works!\n",
    "# Python creates a temporary tuple (b, a) which is (20, 10) and then unpacks it back into the variables a and b.\n",
    "\n",
    "a, b = b, a\n",
    "\n",
    "print(f\"After swap: a = {a}, b = {b}\")"
   ]
